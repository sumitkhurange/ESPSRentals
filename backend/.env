# Gmail SMTP Configuration for Real Emails
# 1. Enter your Gmail address in SMTP_USER
# 2. Enter your 16-character App Password (NOT your normal password) in SMTP_PASS
# To generate an App Password, go to Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_USER=
SMTP_PASS=

# Twilio SMS Configuration for Real SMS OTP Messages
# 1. Enter your Twilio Account SID in TWILIO_ACCOUNT_SID
# 2. Enter your Twilio Auth Token in TWILIO_AUTH_TOKEN
# 3. Enter your Twilio Phone Number in TWILIO_PHONE_NUMBER
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
